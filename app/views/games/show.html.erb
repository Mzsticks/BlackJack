
<div class="blackjack-table">

  <div class="game-panel">

    <h1 class="game-title">BLACKJACK</h1>

    <p class="game-subtitle">
      Welcome to the BlackJack Challenge!
      Try Your Best to Beat the Dealer!
    </p>

    <hr class="game-divider">

      <!-- Player section -->
    <h2 class="hand-title">Your Hand</h2>

    <div class="card-container">
      <% @game.player_hand.each do |card| %>

        <div class="playing-card <%= %w[♥ ♦].include?(card[:suit]) ? 'red-suit' : 'black-suit' %>">
          <%= card[:rank] %><%= card[:suit] %>
        </div>

      <% end %>
    </div>

    <h3 class="hand-score">
      Your Score: <%= @game.score(@game.player_hand) %>
    </h3>    

    <hr class="game-divider">

    <!-- Dealer section -->
    <h2 class="hand-title">Dealer</h2>

    <div class="card-container">
      <% @game.dealer_hand.each_with_index do |card, index| %>

        <% if index == 1 && !@game.finished? %>

          <div class="hidden-card">?</div>

        <% else %>

          <div class="playing-card <%= %w[♥ ♦].include?(card[:suit]) ? 'red-suit' : 'black-suit' %>">
            <%= card[:rank] %><%= card[:suit] %>
          </div>

        <% end %>

      <% end %>
    </div>

    <% if @game.finished? %>
      <h3 class="hand-score">
        Dealer Score: <%= @game.score(@game.dealer_hand) %>
      </h3>
    <% end %>    

    <!-- Result or game controls -->
    <% if @game.finished? %>

      <h2 class="game-result">
        <%= @game.result %>
      </h2>

    <% else %>

      <div class="game-actions">

        <%= button_to "HIT",
          hit_path,
          method: :post,
          class: "game-button" %>

        <%= button_to "STAND",
          stand_path,
          method: :post,
          class: "game-button" %>

      </div>

    <% end %>

    <!-- New game button -->
    <div class="new-game-container">

      <%= button_to "NEW GAME",
        new_game_path,
        method: :post,
        class: "game-button new-game-button" %>

    </div>

  </div>

</div>
